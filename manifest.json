{
  "manifest_version": 3,
  "name": "PRs-AI",
  "version": "1.0.0",
  "description": "AI-powered PR description and title generator for GitHub and GitLab",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://github.com/*",
    "https://gitlab.com/*",
    "https://*.gitlab.com/*",
    "https://gitlab.enosta.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/compare*",
        "https://github.com/*/pull/new*",
        "https://github.com/*/pull/*",
        "https://gitlab.com/*/-/merge_requests/new*",
        "https://gitlab.com/*/-/merge_requests/*/edit*",
        "https://gitlab.com/*/-/merge_requests/*",
        "https://gitlab.com/*/-/compare*",
        "https://gitlab.enosta.com/*/-/merge_requests/new*",
        "https://gitlab.enosta.com/*/-/merge_requests/*/edit*",
        "https://gitlab.enosta.com/*/-/merge_requests/*",
        "https://gitlab.enosta.com/*/-/compare*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PRs-AI Settings"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": [
        "https://github.com/*",
        "https://gitlab.com/*",
        "https://*.gitlab.com/*",
        "https://gitlab.enosta.com/*"
      ]
    }
  ]
}
